# Copy to .env and edit before first run.

# Neon Postgres connection string (use the pooled connection string for Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Local SQLite source used only by `npm run setup` to copy your existing login.
DATABASE_PATH="./data/hre.db"

# REQUIRED: a long random secret used to sign session cookies.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the deployed app (used by the capture extension flow).
APP_URL="http://localhost:3000"

# Optional credentials for a new admin created by `npm run seed`.
# `npm run setup` instead copies the existing local login.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
