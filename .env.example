# Copy to .env and edit before first run.

# Where the SQLite database file lives (created automatically on first run).
DATABASE_PATH="./data/hre.db"

# REQUIRED: a long random secret used to sign session cookies.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the deployed app (used by the capture extension flow).
APP_URL="http://localhost:3000"

# Credentials for the first admin account, created by `npm run seed`.
SEED_ADMIN_EMAIL="admin@cabc.org.za"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="CABC Admin"
